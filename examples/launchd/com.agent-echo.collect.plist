<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agent-echo.collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/example/.cargo/bin/agent-echo</string>
    <string>--config</string><string>/Users/example/.config/agent-echo/config.toml</string>
    <string>collect</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/example/Library/Logs/agent-echo.log</string>
  <key>StandardErrorPath</key><string>/Users/example/Library/Logs/agent-echo-error.log</string>
</dict>
</plist>
